	<string>$(VIZIT_AUTH_SCHEME)</string>
	<key>VIZITPrivacyPolicyURL</key>
	<string>$(VIZIT_PRIVACY_POLICY_URL)</string>
	<key>VIZITPrivacyPolicyVersion</key>
	<string>$(VIZIT_PRIVACY_POLICY_VERSION)</string>
	<key>VIZITPublicProfileBaseURL</key>
