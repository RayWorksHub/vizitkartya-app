	<key>VIZITSupabaseURL</key>
	<string>$(VIZIT_SUPABASE_URL)</string>
	<key>VIZITTermsURL</key>
	<string>$(VIZIT_TERMS_URL)</string>
	<key>VIZITTermsVersion</key>
	<string>$(VIZIT_TERMS_VERSION)</string>
